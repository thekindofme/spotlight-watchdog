#!/bin/bash
# spotlight-watchdog: warn when macOS Spotlight silently stops indexing.
#
# Two checks:
#   1. Write a file with a unique token and wait for Spotlight to find it.
#   2. Every app in /Applications and ~/Applications should be in the index.
#
# Usage: spotlight-watchdog [--quiet]
#   --quiet  print and log only, no notification
# Exit code: 0 healthy, 1 broken.

MDFIND=${MDFIND:-mdfind}
PROBE_DIR=${SPOTLIGHT_WATCHDOG_PROBE_DIR:-"$HOME/Library/Application Support/spotlight-watchdog"}
APP_DIRS=${SPOTLIGHT_WATCHDOG_APP_DIRS:-"/Applications:$HOME/Applications"}
LOG=${SPOTLIGHT_WATCHDOG_LOG:-"$HOME/Library/Logs/spotlight-watchdog.log"}
TIMEOUT=${SPOTLIGHT_WATCHDOG_TIMEOUT:-60}
INTERVAL=${SPOTLIGHT_WATCHDOG_INTERVAL:-5}
GRACE=${SPOTLIGHT_WATCHDOG_GRACE:-60}
FIX="sudo killall mds mds_stores"

quiet=0
case "${1:-}" in
  --quiet) quiet=1 ;;
  "") ;;
  *) echo "usage: spotlight-watchdog [--quiet]" >&2; exit 2 ;;
esac

problems=""

# 1. Probe file. The token is in the file name so runs never clash.
mkdir -p "$PROBE_DIR"
token="probe-$(date +%s)-$$-$RANDOM"
probe="$PROBE_DIR/$token.txt"
: > "$probe"
trap 'rm -f "$probe"' EXIT
waited=0
until [ -n "$("$MDFIND" -onlyin "$PROBE_DIR" -name "$token" 2>/dev/null)" ]; do
  if [ "$waited" -ge "$TIMEOUT" ]; then
    problems="a new file was not indexed within ${TIMEOUT}s"
    break
  fi
  sleep "$INTERVAL"
  waited=$((waited + INTERVAL))
done

# 2. Installed apps. Skip symlinks (Spotlight never indexes them) and apps
# installed in the last $GRACE minutes (they may still be indexing). Installers keep the
# original mtime, so check ctime, which is set when the app is copied in.
missing=""
IFS=: read -r -a dirs <<< "$APP_DIRS"
for dir in "${dirs[@]}"; do
  [ -d "$dir" ] || continue
  dir=$(cd "$dir" && pwd -P)
  indexed=$("$MDFIND" -onlyin "$dir" "kMDItemContentType == 'com.apple.application-bundle'" 2>/dev/null)
  for app in "$dir"/*.app; do
    [ -d "$app" ] && [ ! -L "$app" ] || continue
    [ "$GRACE" -gt 0 ] && [ -n "$(find "$app" -maxdepth 0 -cmin "-$GRACE")" ] && continue
    grep -qxF -- "$app" <<< "$indexed" || missing="$missing, $(basename "$app" .app)"
  done
done
[ -n "$missing" ] && problems="${problems:+$problems; }apps not indexed: ${missing#, }"

mkdir -p "$(dirname "$LOG")"
now=$(date '+%F %T')

if [ -z "$problems" ]; then
  echo "$now OK" >> "$LOG"
  echo "Spotlight OK"
  exit 0
fi

echo "$now BROKEN: $problems" >> "$LOG"
echo "Spotlight BROKEN: $problems"
echo "Fix: $FIX  (or restart your Mac)"
if [ "$quiet" -eq 0 ]; then
  osascript \
    -e 'on run argv' \
    -e 'display notification (item 2 of argv) with title (item 1 of argv) sound name "Basso"' \
    -e 'end run' \
    "Spotlight has stopped indexing" "Restart your Mac, or run: $FIX" >/dev/null 2>&1
fi
exit 1
